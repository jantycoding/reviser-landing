# Скопируйте файл в .env и заполните значения.
# .env в git не попадает — там лежат ваши реальные контакты и ключи.
#
# ВАЖНО ПРО БЕЗОПАСНОСТЬ.
# Всё, что начинается с VITE_, вшивается в JS-бандл и видно любому посетителю
# через «Просмотр кода страницы». Туда можно класть только то, что и так
# публично: номер телефона, id пикселя, адрес почты.
# Секреты (токен бота, ключи платёжного провайдера) кладутся БЕЗ префикса VITE_
# и читаются только серверными функциями из папки api/.


# ─── Публичное: попадает в бандл ──────────────────────────────────────────

# Номер WhatsApp в международном формате: без «+», пробелов, скобок и дефисов.
# Пример для Казахстана: 77011234567
# Пока стоит заглушка, все кнопки «Написать в WhatsApp» ведут в никуда.
VITE_WHATSAPP=77011234567

# Почта и ссылка на инстаграм — показываются в подвале.
VITE_EMAIL=hello@example.kz
VITE_INSTAGRAM=https://instagram.com/your_account

# Реквизиты одной строкой, как в договоре-оферте. Показываются в подвале.
# Пример: ИП Иванов И.И. · ИИН 000000000000
VITE_LEGAL=

# ID пикселя Meta (15–16 цифр из Events Manager).
# Если не задан — пиксель вообще не грузится, и ни одного запроса
# к facebook.net на странице не появляется.
VITE_META_PIXEL_ID=

# Адрес бэкенда оплаты — БЕЗ слэша на конце.
# Пока не задан, блок #checkout работает в запасном режиме: форма уводит
# в WhatsApp, счёт выставляется вручную. Это рабочий режим, а не заглушка.
# Когда появится бэкенд с эндпоинтами /invoice, /status, /webhook, /verify —
# впишите его сюда, и блок переключится сам.
# VITE_PAY_ENDPOINT=https://pay.example.kz


# ─── Секретное: только на сервере, в бандл НЕ попадает ────────────────────
# Эти две переменные задаются в Vercel → Settings → Environment Variables,
# а локально — в .env для команды `vercel dev`.

# Токен бота от @BotFather. Туда падают заявки с сайта.
TELEGRAM_BOT_TOKEN=

# ID чата или группы, куда бот шлёт заявки.
# Как узнать: добавьте бота в группу, напишите туда что-нибудь, откройте
# https://api.telegram.org/bot<ТОКЕН>/getUpdates и возьмите поле chat.id
# (у групп он отрицательный — минус тоже часть id).
TELEGRAM_CHAT_ID=

# Строка подключения к Neon — берётся в панели Neon, вкладка Connect,
# ОБЯЗАТЕЛЬНО вариант «Pooled connection» (в адресе есть «-pooler»).
# Непулированная строка на serverless-функциях быстро упирается в лимит
# соединений: каждая функция открывает своё, закрыть их некому.
# Если переменная пуста — заявки не сохраняются, но в телеграм уходят
# по-прежнему: api/lead.js поднимает клиент лениво и переживает её отсутствие.
DATABASE_URL=

# Общий секрет для вебхука телеграма (кнопки «Беру / Дозвонился / Не отвечает»).
# Придумывается один раз, любая случайная строка длиной от 32 символов.
# Тот же секрет передаётся телеграму при регистрации вебхука параметром
# secret_token, и api/tg.js сверяет его с заголовком
# X-Telegram-Bot-Api-Secret-Token. Пока переменная пуста, api/tg.js
# отклоняет ВСЕ запросы — это защита, а не поломка: без проверки подписи
# любой человек, знающий адрес функции, менял бы статусы заявок.
TELEGRAM_WEBHOOK_SECRET=
