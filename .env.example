# Скопируйте файл в .env и заполните значения.
# .env не попадает в git — там лежат ваши реальные контакты.

# Номер WhatsApp в международном формате, без «+», пробелов и скобок.
# На него уйдёт заявка, если VITE_FORM_ENDPOINT не задан.
VITE_WHATSAPP=77010000000

# Куда POST-ить заявку в формате JSON: Formspree, Telegram-бот, свой webhook.
# Если строку не задать — форма откроет WhatsApp с готовым текстом.
# VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxx
